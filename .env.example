# Valeurs factices : copier en .env (jamais commité) et adapter.
# Sous Docker Swarm, les services se joignent par leur nom DNS sur banking-network.
SERVER_PORT=8080
IDENTITY_SERVICE_URL=http://identity-service:8081
CORE_BANKING_SERVICE_URL=http://core-banking-service:8082
PAYMENT_SERVICE_URL=http://payment-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

# --- B3/B4 : sécurité JWT (contrat §4) ---
# Issuer attendu dans le claim "iss" des tokens émis par Identity
JWT_ISSUER=identity-service
# Clé publique d'Identity (JWKS). Par défaut : IDENTITY_SERVICE_URL + /.well-known/jwks.json
JWKS_URI=http://identity-service:8081/.well-known/jwks.json
# Routes réservées aux ADMIN, séparées par des virgules (contrat §3). Provisoire, à confirmer avec Core Banking
ADMIN_PATHS=/api/accounts/*/unblock
LOG_LEVEL=INFO

# --- B5 : rate limiting (Redis) et CORS ---
REDIS_HOST=redis
REDIS_PORT=6379
# Origine(s) du frontend React, séparées par des virgules (jamais "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
# Nombre de proxys de confiance devant le gateway (0 = on ignore X-Forwarded-For).
# ATTENTION Swarm : derrière le routage interne (ingress), tous les clients paraissent avoir la même IP.
# Publier le port du gateway en mode "host" (voir README) ou régler cette valeur selon le proxy réel.
RATE_LIMIT_TRUSTED_PROXIES=0
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_IP_PER_SECOND=20
RATE_LIMIT_IP_BURST=40
# Limite par utilisateur authentifié (claim sub), en plus de la limite par IP
RATE_LIMIT_USER_PER_SECOND=10
RATE_LIMIT_USER_BURST=20

# Validation des entrées : corps maximal (octets), Content-Type, format de Idempotency-Key
VALIDATION_ENABLED=true
MAX_BODY_BYTES=1048576
KYC_MAX_BODY_BYTES=10485760

# Métriques Prometheus : port interne, jamais publié (0 = désactivé)
METRICS_PORT=9090

# TLS sur le gateway (désactivé par défaut ; voir docker-stack.tls.yml). Le mot de passe du keystore est un secret Docker
SSL_ENABLED=false
SSL_KEYSTORE=

# --- B6 : journalisation ---
# Format des logs : ecs ou logstash (une ligne JSON par événement)
LOG_FORMAT=ecs

# --- B7 : résilience (timeouts et circuit breaker, un circuit par service aval) ---
RESILIENCE_TIMEOUT_MS=3000
RESILIENCE_WINDOW_SIZE=10
RESILIENCE_MINIMUM_CALLS=5
RESILIENCE_FAILURE_RATE=50
RESILIENCE_OPEN_SECONDS=10
RESILIENCE_HALF_OPEN_CALLS=3
