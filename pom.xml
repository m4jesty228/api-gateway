<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Le parent Spring Boot fixe les versions de toutes les dépendances Spring (4.1.x, voir contrat §7) -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.neobank</groupId>
  <artifactId>api-gateway</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>api-gateway</name>
  <description>Point d'entrée unique de la Digital Banking Platform</description>

  <properties>
    <java.version>21</java.version>
    <!-- Release train Spring Cloud compatible avec Boot 4.1 : un décalage fait échouer le démarrage -->
    <spring-cloud.version>2025.1.4</spring-cloud.version>

    <!-- B11 : outils de la chaîne DevSecOps. Versions figées ici UNIQUEMENT (le Jenkinsfile n'en cite aucune).
         Pour chercher des mises à jour : mvn versions:display-plugin-updates -->
    <jacoco.version>0.8.13</jacoco.version>
    <dependency-check.version>12.2.2</dependency-check.version>
    <cyclonedx.version>2.9.1</cyclonedx.version>
    <sonar-maven.version>5.7.0.6970</sonar-maven.version>

    <!-- SonarQube : identité du projet et chemin du rapport de couverture produit par JaCoCo -->
    <sonar.projectKey>neobank-api-gateway</sonar.projectKey>
    <sonar.projectName>API Gateway</sonar.projectName>
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <!-- La méthode main ne se teste pas : on l'écarte du calcul de couverture, pas de l'analyse -->
    <sonar.coverage.exclusions>**/ApiGatewayApplication.java</sonar.coverage.exclusions>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Moteur du gateway (WebFlux). Ajouté dès B1 car c'est le coeur du service -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>

    <!-- Endpoints /actuator/health (+ probes liveness/readiness pour Swarm, puis Kubernetes) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Sécurité WebFlux + validation des JWT (RS256 via JWKS) : cœur de B3 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Client Redis réactif (Lettuce) : stocke les compteurs du rate limiting (B5) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
    </dependency>

    <!-- Circuit breaker Resilience4j (version réactive, pour WebFlux) : cœur de B7 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
    </dependency>

    <!-- Métriques au format Prometheus (cahier des charges §17), servies sur un port interne par MetricsServer -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- B9 : conteneurs réels pour les tests d'intégration (Redis).
         Sans version : Spring Boot 4 gère Testcontainers 2.x, seule série compatible avec Docker 29+
         (l'ancienne série 1.x ne détecte plus Docker : les tests étaient ignorés en silence). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Produit le jar exécutable utilisé par le Dockerfile multi-stage (B10) -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Couverture de tests : alimente SonarQube. prepare-agent ajoute l'agent aux tests, report écrit
           target/site/jacoco/jacoco.xml (lu par Sonar) et un rapport HTML consultable -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>rapport</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- SCA : cherche les CVE connues dans les dépendances (cahier des charges, section 13).
           Volontairement NON lié au cycle de build : lancé par "mvn dependency-check:check" (Jenkins ou à la main),
           car la première exécution télécharge la base NVD (long). -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>${dependency-check.version}</version>
        <configuration>
          <!-- Le build échoue dès une CVE CRITICAL (score CVSS 9 ou plus) sans exception documentée -->
          <failBuildOnCVSS>9</failBuildOnCVSS>
          <!-- Clé NVD lue dans la variable d'environnement NVD_API_KEY : jamais écrite dans le dépôt -->
          <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
          <!-- OSS Index exige désormais un jeton : on s'appuie sur la base NVD seule -->
          <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
          <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
          <formats>
            <format>HTML</format>
            <format>JSON</format>
          </formats>
          <!-- Exceptions : chaque suppression doit être justifiée et datée (voir le fichier) -->
          <suppressionFiles>
            <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
          </suppressionFiles>
        </configuration>
      </plugin>

      <!-- SBOM : inventaire complet des composants livrés, au format CycloneDX (JSON et XML).
           Lancé par "mvn cyclonedx:makeAggregateBom" ; résultat dans target/bom.json -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx.version}</version>
        <configuration>
          <projectType>application</projectType>
          <outputFormat>all</outputFormat>
          <outputName>bom</outputName>
          <!-- Les dépendances de test ne sont pas livrées : hors SBOM -->
          <includeTestScope>false</includeTestScope>
        </configuration>
      </plugin>

      <!-- SAST : envoi de l'analyse à SonarQube. Appelé avec le nom complet du plugin (voir Jenkinsfile) :
           "mvn sonar:sonar" peut sinon résoudre un ancien plugin -->
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${sonar-maven.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
